@tool
class_name GDHPRBlueprintCompiler
extends RefCounted
## Translates a [GDHPRBlueprintGraph] into readable, portable GDScript.
##
## The output is ordinary GDScript with no GDHPR dependency: you can save it
## over an existing script, keep editing it by hand, or version it like normal
## code. That is the whole point — visual authoring, textual result.

const MAX_EXPR_DEPTH := 32
const RESERVED_WORDS: PackedStringArray = [
	"if", "else", "elif", "for", "while", "match", "return", "func", "var", "const",
	"class", "class_name", "extends", "signal", "await", "pass", "break", "continue",
	"and", "or", "not", "in", "is", "as", "self", "true", "false", "null", "void",
]


## Convenience wrapper: returns just the generated source.
static func compile(graph: GDHPRBlueprintGraph) -> String:
	return String(compile_graph(graph)["code"])


## Compiles [param graph] and returns
## [code]{"code": String, "warnings": PackedStringArray}[/code].
static func compile_graph(graph: GDHPRBlueprintGraph) -> Dictionary:
	var warnings := PackedStringArray()
	if graph == null:
		return {"code": "# GDHPR Blueprint: empty graph\n", "warnings": warnings}

	var lines := PackedStringArray()
	lines.append("# Generated by GDHPR Blueprint (%s)." % graph.graph_name)
	lines.append("# Visual source: the matching .tres graph. Edit the graph, not this file.")
	lines.append("extends %s" % (graph.base_class if not graph.base_class.is_empty() else "Node3D"))
	lines.append("")

	var variables := _collect_variables(graph, warnings)
	for var_name in variables:
		var declaration: Dictionary = variables[var_name]
		lines.append("%s %s%s = %s" % [
			"@export var" if bool(declaration.get("export", false)) else "var",
			var_name,
			_type_hint(String(declaration.get("type", ""))),
			_literal(declaration.get("initial")),
		])
	if not variables.is_empty():
		lines.append("")

	var events := graph.event_nodes()
	if events.is_empty():
		warnings.append("The graph has no event node, so it generates an empty script.")
	var has_process := false
	for event in events:
		if String(event["type"]) == "event_process":
			has_process = true
	if not has_process and _uses_type(graph, "get_delta"):
		warnings.append("Delta is only meaningful inside an On Process event.")

	# Function references: duplicate definitions and calls to nothing.
	var defined_functions := {}
	for node in graph.nodes:
		if String(node["type"]) != "func_define":
			continue
		var defined_name := _sanitize_identifier(String(node.get("props", {}).get("function", "")))
		if defined_name.is_empty():
			continue
		if defined_functions.has(defined_name):
			warnings.append("Function '%s' is defined more than once." % defined_name)
		defined_functions[defined_name] = true
	for node in graph.nodes:
		if String(node["type"]) != "call_custom":
			continue
		var called_name := _sanitize_identifier(String(node.get("props", {}).get("function", "")))
		if not defined_functions.has(called_name):
			warnings.append(
				"Call Function references undefined function '%s'."
				% (called_name if not called_name.is_empty() else "?")
			)

	# On Signal nodes with a connect target are wired up from _ready.
	var signal_preamble := PackedStringArray()
	var has_ready := false
	for event in events:
		var event_type := String(event["type"])
		if event_type == "event_ready":
			has_ready = true
		elif event_type == "event_signal":
			var signal_props: Dictionary = event.get("props", {})
			var target_text := String(signal_props.get("connect_target", "self")).strip_edges()
			var signal_name := Identifiers.sanitize(String(signal_props.get("signal_name", "")))
			if target_text.is_empty() or signal_name.is_empty():
				continue
			signal_preamble.append("\t%s.%s.connect(self.%s)" % [
				_target(target_text), signal_name, _signal_handler_name(signal_name),
			])

	var emitted_functions := {}
	for event in events:
		if String(event["type"]) == "func_define":
			var emit_name := _sanitize_identifier(String(event.get("props", {}).get("function", "")))
			# A duplicate definition would not compile, so only emit the first one.
			if emitted_functions.has(emit_name):
				continue
			emitted_functions[emit_name] = true
		_emit_event(graph, event, lines, warnings, signal_preamble)

	if not has_ready and not signal_preamble.is_empty():
		lines.append("func _ready() -> void:")
		for line in signal_preamble:
			lines.append(line)
		lines.append("")

	var code := "\n".join(lines)
	if not code.ends_with("\n"):
		code += "\n"
	return {"code": code, "warnings": warnings}


## Returns true when the graph can produce a non-empty script.
static func is_executable(graph: GDHPRBlueprintGraph) -> bool:
	return graph != null and not graph.event_nodes().is_empty()


static func _emit_event(
	graph: GDHPRBlueprintGraph,
	event: Dictionary,
	lines: PackedStringArray,
	warnings: PackedStringArray,
	preamble: PackedStringArray = PackedStringArray()
) -> void:
	var id := int(event["id"])
	var type := String(event["type"])
	var props: Dictionary = event.get("props", {})
	match type:
		"event_ready":
			lines.append("func _ready() -> void:")
			var ready_start := lines.size()
			for line in preamble:
				lines.append(line)
			_emit_chain(graph, id, 0, lines, 1, warnings, _context(false))
			if lines.size() == ready_start:
				lines.append("\tpass")
			lines.append("")
		"event_process":
			lines.append("func _process(delta: float) -> void:")
			_emit_block(graph, id, 0, lines, 1, warnings, _context(true))
			lines.append("")
		"event_input":
			var action := _sanitize_action(String(props.get("action", "ui_accept")))
			lines.append("func _unhandled_input(event: InputEvent) -> void:")
			lines.append("\tif event.is_action_pressed(\"%s\"):" % action)
			_emit_block(graph, id, 0, lines, 2, warnings, _context(false))
			lines.append("")
		"func_define":
			var function_name := _sanitize_identifier(String(props.get("function", "")))
			if function_name.is_empty():
				warnings.append("A Function node has no name; it was skipped.")
				return
			if function_name == "_ready" or function_name == "_process":
				warnings.append("Function '%s' collides with a built-in callback." % function_name)
			var argument_names := PackedStringArray()
			for i in clampi(int(props.get("arg_count", 0)), 0, 3):
				var argument_name := _sanitize_identifier(String(props.get("arg%d" % i, "arg%d" % i)))
				argument_names.append(argument_name + _type_hint(String(props.get("arg%d_type" % i, ""))))
			var return_type := String(props.get("return_type", "void"))
			lines.append("func %s(%s)%s:" % [function_name, ", ".join(argument_names), _return_hint(return_type)])
			var function_context := _context(false)
			function_context["in_function"] = true
			function_context["return_type"] = return_type
			_emit_block(graph, id, 0, lines, 1, warnings, function_context)
			lines.append("")
		"signal_declare":
			var declared_signal := Identifiers.sanitize(String(props.get("signal_name", "")))
			if declared_signal.is_empty():
				warnings.append("A Signal node has no name; it was skipped.")
				return
			var signal_args := PackedStringArray()
			for i in clampi(int(props.get("arg_count", 0)), 0, 2):
				var signal_arg := _sanitize_identifier(String(props.get("arg%d" % i, "arg%d" % i)))
				signal_args.append(signal_arg + _type_hint(String(props.get("arg%d_type" % i, ""))))
			lines.append("signal %s(%s)" % [declared_signal, ", ".join(signal_args)])
			lines.append("")
		"event_signal":
			var handled_signal := Identifiers.sanitize(String(props.get("signal_name", "")))
			if handled_signal.is_empty():
				warnings.append("An On Signal node has no signal name; it was skipped.")
				return
			var handler_args := PackedStringArray()
			for i in clampi(int(props.get("arg_count", 0)), 0, 2):
				var handler_arg := _sanitize_identifier(String(props.get("arg%d" % i, "arg%d" % i)))
				handler_args.append(handler_arg + _type_hint(String(props.get("arg%d_type" % i, ""))))
			lines.append("func %s(%s):" % [_signal_handler_name(handled_signal), ", ".join(handler_args)])
			var handler_context := _context(false)
			handler_context["in_function"] = true
			_emit_block(graph, id, 0, lines, 1, warnings, handler_context)
			lines.append("")
		_:
			warnings.append("Unknown event type '%s'." % type)


## Fresh codegen context. Dictionaries are references, so loops and functions
## always pass a copy when they change scope.
static func _context(delta_available: bool) -> Dictionary:
	return {"delta": delta_available, "loop_depth": 0, "in_function": false}


## Emits a chain as a full block: empty blocks get a [code]pass[/code].
## Child scope context: one loop deeper.
static func _deeper(context: Dictionary) -> Dictionary:
	var inner := context.duplicate()
	inner["loop_depth"] = int(context.get("loop_depth", 0)) + 1
	return inner


static func _type_hint(type_name: String) -> String:
	if type_name.is_empty() or type_name == "Variant":
		return ""
	return ": " + type_name


static func _return_hint(type_name: String) -> String:
	if type_name.is_empty() or type_name == "Variant":
		return ""
	return " -> " + type_name


static func _signal_handler_name(signal_name: String) -> String:
	return "_on_" + Identifiers.sanitize(signal_name)


static func _function_name(props: Dictionary) -> String:
	var name := _sanitize_identifier(String(props.get("function", "")))
	return name if not name.is_empty() else "_undefined_function"


static func _call_arguments(
	graph: GDHPRBlueprintGraph,
	node_id: int,
	props: Dictionary,
	warnings: PackedStringArray
) -> String:
	var count := clampi(int(props.get("arg_count", 0)), 0, 3)
	var args := PackedStringArray()
	for i in count:
		args.append(_value_or(graph, node_id, 1 + i, "null", warnings, 0))
	return ", ".join(args)


static func _emit_block(
	graph: GDHPRBlueprintGraph,
	node_id: int,
	port: int,
	lines: PackedStringArray,
	indent: int,
	warnings: PackedStringArray,
	context: Dictionary
) -> void:
	var start := lines.size()
	_emit_chain(graph, node_id, port, lines, indent, warnings, context)
	if lines.size() == start:
		lines.append("\t".repeat(indent) + "pass")


## Emits the statement chain leaving output [param port] of [param node_id].
static func _emit_chain(
	graph: GDHPRBlueprintGraph,
	node_id: int,
	port: int,
	lines: PackedStringArray,
	indent: int,
	warnings: PackedStringArray,
	context: Dictionary
) -> void:
	for link in graph.links_from(node_id, port):
		_emit_node(graph, int(link["to_node"]), lines, indent, warnings, context)


static func _emit_node(
	graph: GDHPRBlueprintGraph,
	node_id: int,
	lines: PackedStringArray,
	indent: int,
	warnings: PackedStringArray,
	context: Dictionary
) -> void:
	var data := graph.node_data(node_id)
	if data.is_empty():
		return
	var type := String(data["type"])
	var props: Dictionary = data.get("props", {})
	var pad := "\t".repeat(indent)

	match type:
		"print":
			var message := _value_or(graph, node_id, 1, _literal(props.get("text", "")), warnings, 0)
			lines.append(pad + "print(%s)" % message)
			_emit_chain(graph, node_id, 0, lines, indent, warnings, context)
		"if_branch":
			var condition := _value_or(graph, node_id, 1, "false", warnings, 0)
			lines.append(pad + "if %s:" % condition)
			_emit_block(graph, node_id, 0, lines, indent + 1, warnings, context)
			if not graph.links_from(node_id, 1).is_empty():
				lines.append(pad + "else:")
				_emit_block(graph, node_id, 1, lines, indent + 1, warnings, context)
		"set_var":
			var var_name := _sanitize_identifier(String(props.get("variable", "my_value")))
			var fallback_value: Variant = props.get("value", 0.0)
			if graph.link_into(node_id, 1).is_empty():
				# Keep the assignment valid for the declared type.
				fallback_value = _default_for_type(String(props.get("type", "Variant")), fallback_value)
			var value := _value_or(graph, node_id, 1, _literal(fallback_value), warnings, 0)
			lines.append(pad + "%s = %s" % [var_name, value])
			_emit_chain(graph, node_id, 0, lines, indent, warnings, context)
		"call_method":
			var raw_target := String(props.get("target", "self"))
			var method := Identifiers.sanitize(String(props.get("method", "print")))
			var count := clampi(int(props.get("arg_count", 0)), 0, 2)
			var args := PackedStringArray()
			for i in count:
				args.append(_value_or(graph, node_id, 1 + i, "null", warnings, 0))
			# Unprefixed for self so built-in global functions (print, push_error,
			# ...) and own methods both work.
			if raw_target.strip_edges() == "self" or raw_target.strip_edges().is_empty():
				lines.append(pad + "%s(%s)" % [method, ", ".join(args)])
			else:
				lines.append(pad + "%s.%s(%s)" % [_target(raw_target), method, ", ".join(args)])
			_emit_chain(graph, node_id, 0, lines, indent, warnings, context)
		"set_property":
			var target := _target(String(props.get("target", "self")))
			var prop := Identifiers.sanitize(String(props.get("property", "visible")))
			var value := _value_or(graph, node_id, 1, _literal(props.get("value", true)), warnings, 0)
			lines.append(pad + "%s.%s = %s" % [target, prop, value])
			_emit_chain(graph, node_id, 0, lines, indent, warnings, context)
		"wait":
			var seconds := _value_or(graph, node_id, 1, _literal(props.get("seconds", 1.0)), warnings, 0)
			lines.append(pad + "await get_tree().create_timer(%s).timeout" % seconds)
			_emit_chain(graph, node_id, 0, lines, indent, warnings, context)
		"for_range":
			var loop_variable := _sanitize_identifier(String(props.get("variable", "i")))
			var from_expression := _value_or(graph, node_id, 1, _literal(props.get("from", 0.0)), warnings, 0)
			var to_expression := _value_or(graph, node_id, 2, _literal(props.get("to", 10.0)), warnings, 0)
			lines.append(pad + "for %s in range(%s, %s):" % [loop_variable, from_expression, to_expression])
			_emit_block(graph, node_id, 0, lines, indent + 1, warnings, _deeper(context))
			_emit_chain(graph, node_id, 1, lines, indent, warnings, context)
		"while_loop":
			var condition := _value_or(graph, node_id, 1, "false", warnings, 0)
			lines.append(pad + "while %s:" % condition)
			_emit_block(graph, node_id, 0, lines, indent + 1, warnings, _deeper(context))
			_emit_chain(graph, node_id, 1, lines, indent, warnings, context)
		"loop_break", "loop_continue":
			if int(context.get("loop_depth", 0)) <= 0:
				warnings.append("%s used outside a loop; generated code will not compile."
					% ("Break" if type == "loop_break" else "Continue"))
			lines.append(pad + ("break" if type == "loop_break" else "continue"))
		"func_return":
			if not bool(context.get("in_function", false)):
				warnings.append("Return used outside a Function node; generated code will not compile.")
			var returns_value := not graph.link_into(node_id, 1).is_empty()
			var declared_return := String(context.get("return_type", ""))
			if returns_value and declared_return == "void":
				warnings.append("Return supplies a value but the function's return type is void.")
			elif not returns_value and declared_return not in ["", "void", "Variant"]:
				warnings.append("Return has no value but the function declares -> %s." % declared_return)
			if returns_value:
				lines.append(pad + "return %s" % _value_or(graph, node_id, 1, "null", warnings, 0))
			else:
				lines.append(pad + "return")
		"call_custom":
			var function_name := _function_name(props)
			lines.append(pad + "%s(%s)" % [function_name, _call_arguments(graph, node_id, props, warnings)])
			_emit_chain(graph, node_id, 0, lines, indent, warnings, context)
		"for_each":
			var item_name := _sanitize_identifier(String(props.get("item", "item")))
			var source := _value_or(graph, node_id, 1, "[]", warnings, 0)
			lines.append(pad + "for %s in %s:" % [item_name, source])
			_emit_block(graph, node_id, 0, lines, indent + 1, warnings, _deeper(context))
			_emit_chain(graph, node_id, 1, lines, indent, warnings, context)
		"array_add":
			var array_variable := _sanitize_identifier(String(props.get("variable", "my_array")))
			lines.append(pad + "%s.append(%s)" % [
				array_variable, _value_or(graph, node_id, 1, "null", warnings, 0),
			])
			_emit_chain(graph, node_id, 0, lines, indent, warnings, context)
		"emit_signal":
			var emitted_signal := Identifiers.sanitize(String(props.get("signal_name", "my_signal")))
			var signal_count := clampi(int(props.get("arg_count", 0)), 0, 2)
			var signal_values := PackedStringArray()
			for i in signal_count:
				signal_values.append(_value_or(graph, node_id, 1 + i, "null", warnings, 0))
			var suffix := "" if signal_values.is_empty() else ", " + ", ".join(signal_values)
			lines.append(pad + "emit_signal(\"%s\"%s)" % [emitted_signal, suffix])
			_emit_chain(graph, node_id, 0, lines, indent, warnings, context)
		"connect_signal":
			var connect_target := _target(String(props.get("target", "self")))
			var connected_signal := Identifiers.sanitize(String(props.get("signal_name", "my_signal")))
			var connected_method := _sanitize_identifier(String(props.get("method", "_on_my_signal")))
			lines.append(pad + "%s.%s.connect(%s.%s)" % [
				connect_target, connected_signal, connect_target, connected_method,
			])
			_emit_chain(graph, node_id, 0, lines, indent, warnings, context)
		"dict_set":
			var dict_variable := _sanitize_identifier(String(props.get("variable", "my_dict")))
			var dict_key := _value_or(graph, node_id, 1, "\"key\"", warnings, 0)
			var dict_value := _value_or(graph, node_id, 2, "null", warnings, 0)
			lines.append(pad + "%s[%s] = %s" % [dict_variable, dict_key, dict_value])
			_emit_chain(graph, node_id, 0, lines, indent, warnings, context)
		"wait_signal":
			var awaited_target := _target(String(props.get("target", "self")))
			var awaited_signal := Identifiers.sanitize(String(props.get("signal_name", "my_signal")))
			lines.append(pad + "await %s.%s" % [awaited_target, awaited_signal])
			_emit_chain(graph, node_id, 0, lines, indent, warnings, context)
		"match_node":
			var match_value := _value_or(graph, node_id, 1, "null", warnings, 0)
			var case_count := clampi(int(props.get("case_count", 0)), 0, 3)
			lines.append(pad + "match %s:" % match_value)
			var emitted_case := false
			for i in case_count:
				if graph.links_from(node_id, i).is_empty():
					continue
				var case_value := _value_or(
					graph, node_id, 2 + i, _literal(props.get("case%d" % i, 0.0)), warnings, 0
				)
				lines.append(pad + "\t%s:" % case_value)
				_emit_block(graph, node_id, i, lines, indent + 2, warnings, context)
				emitted_case = true
			if not graph.links_from(node_id, 3).is_empty():
				lines.append(pad + "\t_:")
				_emit_block(graph, node_id, 3, lines, indent + 2, warnings, context)
				emitted_case = true
			if not emitted_case:
				lines.append(pad + "\t_:")
				lines.append(pad + "\t\tpass")
			for i in range(case_count, 3):
				if not graph.links_from(node_id, i).is_empty():
					warnings.append(
						"Match case %d has a chain but only %d case(s) are enabled; that chain is skipped."
						% [i + 1, case_count]
					)
		_:
			if GDHPRBlueprintDefs.get_def(type)["category"] == "Value":
				warnings.append("A value node (%s) is connected as a flow node; ignored." % type)
			else:
				warnings.append("Unsupported node type '%s'." % type)


## Expression for input [param port], falling back to [param fallback].
static func _value_or(
	graph: GDHPRBlueprintGraph,
	node_id: int,
	port: int,
	fallback: String,
	warnings: PackedStringArray,
	depth: int
) -> String:
	var link := graph.link_into(node_id, port)
	if link.is_empty():
		return fallback
	var expression := _expression(graph, int(link["from_node"]), warnings, depth + 1)
	return expression if not expression.is_empty() else fallback


## Expression produced by a value node.
static func _expression(
	graph: GDHPRBlueprintGraph,
	node_id: int,
	warnings: PackedStringArray,
	depth: int
) -> String:
	if depth > MAX_EXPR_DEPTH:
		warnings.append("Expression too deep (possible loop); truncated.")
		return ""
	var data := graph.node_data(node_id)
	if data.is_empty():
		return ""
	var type := String(data["type"])
	var props: Dictionary = data.get("props", {})

	match type:
		"const_float":
			return _literal(props.get("value", 0.0))
		"const_string":
			return _literal(props.get("value", ""))
		"const_bool":
			return _literal(props.get("value", true))
		"const_vector3":
			return _literal(props.get("value", Vector3.ZERO))
		"get_var":
			return _sanitize_identifier(String(props.get("variable", "my_value")))
		"random_range":
			return "randf_range(%s, %s)" % [
				_literal(props.get("min", 0.0)), _literal(props.get("max", 1.0)),
			]
		"get_delta":
			return "delta"
		"get_position":
			return "%s.global_position" % _target(String(props.get("target", "self")))
		"math":
			var op := String(props.get("op", "+"))
			var a := _value_or(graph, node_id, 0, _literal(props.get("a", 0.0)), warnings, depth)
			var b := _value_or(graph, node_id, 1, _literal(props.get("b", 1.0)), warnings, depth)
			if op == "min" or op == "max":
				return "%sf(%s, %s)" % [op, a, b]
			return "(%s %s %s)" % [a, op, b]
		"compare":
			var op := String(props.get("op", "=="))
			var a := _value_or(graph, node_id, 0, _literal(props.get("a", 0.0)), warnings, depth)
			var b := _value_or(graph, node_id, 1, _literal(props.get("b", 0.0)), warnings, depth)
			return "(%s %s %s)" % [a, op, b]
		"call_custom":
			return "%s(%s)" % [_function_name(props), _call_arguments(graph, node_id, props, warnings)]
		"make_array":
			var item_count := clampi(int(props.get("count", 0)), 0, 3)
			var items := PackedStringArray()
			for i in item_count:
				items.append(_value_or(graph, node_id, i, "null", warnings, depth))
			return "[%s]" % ", ".join(items)
		"array_size":
			return "(%s).size()" % _value_or(graph, node_id, 0, "[]", warnings, depth)
		"array_get":
			return "(%s)[%s]" % [
				_value_or(graph, node_id, 0, "[]", warnings, depth),
				_value_or(graph, node_id, 1, "0", warnings, depth),
			]
		"dict_get":
			return "(%s)[%s]" % [
				_value_or(graph, node_id, 0, "{}", warnings, depth),
				_value_or(graph, node_id, 1, "\"key\"", warnings, depth),
			]
		"dict_has":
			return "(%s).has(%s)" % [
				_value_or(graph, node_id, 0, "{}", warnings, depth),
				_value_or(graph, node_id, 1, "\"key\"", warnings, depth),
			]
		"convert":
			var converted := _value_or(graph, node_id, 0, "null", warnings, depth)
			match String(props.get("to", "String")):
				"int":
					return "int(%s)" % converted
				"float":
					return "float(%s)" % converted
				"bool":
					return "bool(%s)" % converted
				_:
					return "str(%s)" % converted
		_:
			warnings.append("Node '%s' cannot be used as a value." % type)
			return ""


## Initial value that is valid for a declared variable type. Without this a
## Dictionary variable would start as 0.0 and the script would not compile.
static func _default_for_type(type_name: String, fallback: Variant) -> Variant:
	match type_name:
		"Array":
			return [] if not fallback is Array else fallback
		"Dictionary":
			return {} if not fallback is Dictionary else fallback
		"int":
			return int(fallback) if typeof(fallback) in [TYPE_INT, TYPE_FLOAT, TYPE_BOOL] else 0
		"float":
			return float(fallback) if typeof(fallback) in [TYPE_INT, TYPE_FLOAT, TYPE_BOOL] else 0.0
		"bool":
			return bool(fallback) if typeof(fallback) in [TYPE_BOOL, TYPE_INT, TYPE_FLOAT] else false
		"String":
			return String(fallback) if fallback is String else ""
		"Vector2":
			return fallback if fallback is Vector2 else Vector2.ZERO
		"Vector3":
			return fallback if fallback is Vector3 else Vector3.ZERO
		"Color":
			return fallback if fallback is Color else Color.WHITE
		"NodePath":
			return fallback if fallback is NodePath else NodePath("")
		"Object", "Node", "Node3D":
			return null
	return fallback


## Collects every variable declared by Set Variable nodes:
## [code]{name: {"initial": Variant, "type": String, "export": bool}}[/code].
static func _collect_variables(
	graph: GDHPRBlueprintGraph,
	warnings: PackedStringArray = PackedStringArray()
) -> Dictionary:
	var variables := {}
	for node in graph.nodes:
		if String(node["type"]) != "set_var":
			continue
		var props: Dictionary = node.get("props", {})
		var name := _sanitize_identifier(String(props.get("variable", "my_value")))
		var initial: Variant = props.get("value", 0.0)
		var declared_type := String(props.get("type", "Variant"))
		var link := graph.link_into(int(node["id"]), 1)
		if link.is_empty():
			initial = _default_for_type(declared_type, initial)
		else:
			var source := graph.node_data(int(link["from_node"]))
			var source_type := String(source.get("type", ""))
			if source_type == "const_string":
				initial = String(source.get("props", {}).get("value", ""))
			elif source_type == "const_bool":
				initial = bool(source.get("props", {}).get("value", true))
			elif source_type == "const_vector3":
				initial = source.get("props", {}).get("value", Vector3.ZERO)
			elif source_type == "make_array":
				initial = []
			elif source_type in ["dict_set", "dict_get", "dict_has"]:
				initial = {}
		if variables.has(name):
			var previous: Dictionary = variables[name]
			if String(previous.get("type", "")) != declared_type:
				warnings.append(
					"Variable '%s' is declared with two different types (%s, %s)."
					% [name, previous.get("type", "Variant"), declared_type]
				)
			if bool(previous.get("export", false)) != bool(props.get("export", false)):
				warnings.append("Variable '%s' is declared both exported and not exported." % name)
			continue
		variables[name] = {
			"initial": initial,
			"type": declared_type,
			"export": bool(props.get("export", false)),
	}
	# Loop variables are locals created by the loop itself, so they are not
	# declared at class scope.
	var loop_names := {}
	for node in graph.nodes:
		var loop_type := String(node.get("type", ""))
		if loop_type == "for_each":
			loop_names[_sanitize_identifier(String(node.get("props", {}).get("item", "item")))] = true
		elif loop_type == "for_range":
			loop_names[_sanitize_identifier(String(node.get("props", {}).get("variable", "i")))] = true
	# Arrays and dictionaries touched by their nodes still need a declaration.
	for node in graph.nodes:
		var node_type := String(node.get("type", ""))
		var node_props: Dictionary = node.get("props", {})
		var inferred_type := ""
		match node_type:
			"array_add":
				inferred_type = "Array"
			"dict_set":
				inferred_type = "Dictionary"
		if inferred_type.is_empty():
			continue
		var raw_name := String(node_props.get("variable", "")).strip_edges()
		if raw_name.is_empty():
			continue
		var implicit_name := _sanitize_identifier(raw_name)
		if implicit_name.is_empty() or variables.has(implicit_name) or loop_names.has(implicit_name):
			continue
		variables[implicit_name] = {
			"initial": _default_for_type(inferred_type, null),
			"type": inferred_type,
			"export": false,
		}
	# Reading a name nothing declares produces a script that cannot compile.
	for node in graph.nodes:
		if String(node.get("type", "")) != "get_var":
			continue
		var read_name := _sanitize_identifier(String(node.get("props", {}).get("variable", "")))
		if read_name.is_empty() or variables.has(read_name) or loop_names.has(read_name):
			continue
		warnings.append(
			"Get Variable '%s' is not declared by a Set Variable node; the generated code will not compile."
			% read_name
		)
	return variables


static func _uses_type(graph: GDHPRBlueprintGraph, type: String) -> bool:
	for node in graph.nodes:
		if String(node["type"]) == type:
			return true
	return false


static func _target(raw: String) -> String:
	var trimmed := raw.strip_edges()
	if trimmed.is_empty() or trimmed == "self":
		return "self"
	if trimmed.begins_with("$") or trimmed.begins_with("get_node"):
		return trimmed
	if trimmed.begins_with("/"):
		return "get_node(\"%s\")" % trimmed
	if trimmed == "get_tree()" or trimmed.begins_with("get_tree()"):
		return trimmed
	return "get_node(\"%s\")" % trimmed


static func _sanitize_action(action: String) -> String:
	return action.replace("\"", "")


## Reserved-safe identifier.
static func _sanitize_identifier(raw: String) -> String:
	var name := Identifiers.sanitize(raw)
	if RESERVED_WORDS.has(name) or name.is_empty():
		name = "_" + name
	return name


## Small helper namespace so the two sanitizer call sites read clearly.
class Identifiers:
	static func sanitize(raw: String) -> String:
		var out := ""
		for i in raw.length():
			var c := raw[i]
			var is_ok := (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") \
				or (c >= "0" and c <= "9") or c == "_"
			out += c if is_ok else "_"
		if out.is_empty():
			return ""
		if out[0] >= "0" and out[0] <= "9":
			out = "_" + out
		return out


static func _literal(value: Variant) -> String:
	match typeof(value):
		TYPE_STRING, TYPE_STRING_NAME:
			return "\"%s\"" % String(value).replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")
		TYPE_BOOL:
			return "true" if bool(value) else "false"
		TYPE_INT:
			return str(int(value))
		TYPE_FLOAT:
			var text := str(snappedf(float(value), 0.000001))
			return text if text.contains(".") or text.contains("e") else text + ".0"
		TYPE_VECTOR3:
			var v: Vector3 = value
			return "Vector3(%s, %s, %s)" % [
				str(snappedf(v.x, 0.000001)), str(snappedf(v.y, 0.000001)), str(snappedf(v.z, 0.000001)),
			]
		TYPE_VECTOR2:
			var v2: Vector2 = value
			return "Vector2(%s, %s)" % [str(snappedf(v2.x, 0.000001)), str(snappedf(v2.y, 0.000001))]
		TYPE_ARRAY:
			var parts := PackedStringArray()
			for item in value:
				parts.append(_literal(item))
			return "[%s]" % ", ".join(parts)
		TYPE_DICTIONARY:
			var entries := PackedStringArray()
			for key in value:
				entries.append("%s: %s" % [_literal(key), _literal(value[key])])
			return "{%s}" % ", ".join(entries)
		TYPE_NIL:
			return "null"
	return "null"
