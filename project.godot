; Engine configuration file for the GDHPR demo project.
; Open this folder in Godot 4.3+ and the addon is already enabled.

config_version=5

[application]

config/name="GDHPR"
config/description="Godot High Performance Rendering — presets, optimization, lighting, materials and visual scripting."
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://addons/gdhpr/icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/gdhpr/plugin.cfg")

[rendering]

anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
occlusion_culling/use_occlusion_culling=true
